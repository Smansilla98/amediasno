# Variables del servicio web en Railway (Variables → Raw Editor).
# No subas valores reales al repositorio.

# Referencia al servicio Postgres del proyecto (Railway la resuelve sola).
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Secreto de sesiones: openssl rand -hex 32. No lo cambies después o se cierran todas las sesiones.
BETTER_AUTH_SECRET=

# URL pública exacta de la app (con https). Si la dejás vacía se usa RAILWAY_PUBLIC_DOMAIN.
BETTER_AUTH_URL=https://amediasno-production.up.railway.app

# Registro: vacío = sólo se puede crear la primera cuenta. true = abierto (para sumar a alguien), false = cerrado.
ALLOW_SIGNUP=

# Hora de Argentina para logs y fechas del servidor.
TZ=America/Argentina/Buenos_Aires
